#!/usr/bin/env bash
# $1 must be min coverage

if [[ -z "$1" ]]; then
	echo "Minimum coverage not specified"
	exit 1
fi

profile=$(mktemp)
trap 'rm -f "${profile}"' EXIT

if ! go test $(go list ./... | grep -v testutil) -race -shuffle on -failfast -timeout 3m -coverprofile "${profile}"; then
	exit 1
fi

cov=$(go tool cover -func "${profile}" | sed -nE 's/^total:.*[[:space:]]([0-9.]+)%$/\1/p')
if [[ -z "${cov}" || "${cov}" == "NaN" ]]; then
	echo "Invalid coverage data"
	exit 1
fi

if awk "BEGIN {exit !("${cov}" < $1)}"; then
	echo "Coverage: ${cov}%, minimum allowed: $1%"
	exit 1
fi

echo "Coverage: ${cov}%"
